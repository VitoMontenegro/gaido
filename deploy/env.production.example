# Server
APP_ENV=production
HTTP_ADDR=:8081
CORS_ORIGINS=https://YOUR_DOMAIN.com,https://www.YOUR_DOMAIN.com,https://svit.YOUR_DOMAIN.com,https://vezu.YOUR_DOMAIN.com,https://servis.YOUR_DOMAIN.com
PUBLIC_BASE_URL=https://svit.YOUR_DOMAIN.com

# PostgreSQL — use sslmode=require or verify-full in production
DATABASE_URL=postgres://tourister:CHANGE_ME_STRONG@127.0.0.1:5432/tourister?sslmode=require

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SESSION_URL=redis://127.0.0.1:6379/1
REDIS_SIGNAL_URL=redis://127.0.0.1:6379/2

# Auth — generate: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Behind nginx/Caddy (required for correct auth rate-limit IP)
TRUST_PROXY=true

# SPA static files (deploy.sh rsyncs apps/*/dist into subdirs)
STATIC_ROOT=/var/www/tourister/www
# Optional override: host=subdir pairs (defaults include gaido.top→portal, svit→svit, …)
# STATIC_HOST_MAP=gaido.top=portal,www.gaido.top=portal,svit.gaido.top=svit
# Legacy single-bundle fallback when STATIC_ROOT is empty:
# STATIC_DIR=/var/www/tourister/www

# Payments
PAYMENT_STUB_ENABLED=false

# Media
MEDIA_STORAGE_PATH=/var/www/tourister/storage
MEDIA_MAX_UPLOAD_MB=10

# Seed — false on production (see DEPLOY.md Фаза 4.1 for first admin)
SEED_DEMO_DATA=false

# Git deploy
GIT_REPO=https://github.com/VitoMontenegro/gaido.git
GIT_BRANCH=main
DEPLOY_ENABLED=true
DEPLOY_SCRIPT=/var/www/tourister/repo/deploy/deploy.sh
DEPLOY_LOG=/var/www/tourister/logs/deploy.log
# API_LOG=/var/www/tourister/logs/api.log
DEPLOY_APP_SLUG=web-prod-2026

# Telegram support bot (optional)
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=gaido_ua_bot
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
