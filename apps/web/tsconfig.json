{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@gaido/api-client/*": ["../../packages/api-client/src/*"],
      "@gaido/site-urls/*": ["../../packages/site-urls/src/*"],
      "@gaido/ui-primitives/*": ["../../packages/ui-primitives/src/*"],
      "@gaido/portal-shell/*": ["../../packages/portal/src/*"],
      "@gaido/guides/*": ["../../packages/guides/src/*"],
      "@gaido/discover/*": ["../../packages/discover/src/*"],
      "@gaido/transport/*": ["../../packages/transport/src/*"]
    }
  },
  "include": ["next-env.d.ts", "css.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
