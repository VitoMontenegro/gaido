{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@gaido/api-client/*": ["../../packages/api-client/src/*"],
      "@gaido/ui-primitives/*": ["../../packages/ui-primitives/src/*"],
      "@gaido/site-urls/*": ["../../packages/site-urls/src/*"],
      "@gaido/portal-shell/*": ["../../packages/portal/src/*"],
      "@gaido/guides/*": ["../../packages/guides/src/*"],
      "@gaido/discover": ["../../packages/discover/src/index.ts"],
      "@gaido/discover/*": ["../../packages/discover/src/*"],
      "@gaido/transport/*": ["../../packages/transport/src/*"]
    }
  },
  "include": ["src", "../../packages/guides/src", "../../packages/ui-primitives/src", "../../packages/build-config/vite.app.ts"]
}
