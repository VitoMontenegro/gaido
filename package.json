{
  "name": "gaido",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @gaido/web",
    "dev": "npm run dev -w @gaido/web",
    "dev:web": "npm run dev -w @gaido/web",
    "start": "npm run start -w @gaido/web",
    "stop:local": "./stop-local.sh",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
