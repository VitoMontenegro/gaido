# Server
APP_ENV=development
# OrbStack занимает :8080/:8081 — локально используем :8091 (см. run-local.sh)
HTTP_ADDR=:8091
BACKEND_PORT=8091
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgres://tourister:tourister@localhost:5433/tourister?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6380/0
REDIS_SESSION_URL=redis://localhost:6380/1
REDIS_SIGNAL_URL=redis://localhost:6380/2

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Payments
PAYMENT_STUB_ENABLED=true

# Media
MEDIA_STORAGE_PATH=./storage
MEDIA_MAX_UPLOAD_MB=10

# Behind nginx/Caddy set TRUST_PROXY=true so rate limits use X-Forwarded-For
TRUST_PROXY=false

# Demo seed is NOT run on API startup. Local only:
#   cd backend && go run ./cmd/seed -demo
# or: LOCAL_SEED=1 ./run-local.sh

# Production: APP_ENV=production triggers config.Validate — see docs/ENV.md
# PAYMENT_STUB_ENABLED=false, unique JWT secrets, no CORS *, TRUST_PROXY=true behind reverse proxy

# Deploy (production only; keep false locally)
DEPLOY_ENABLED=false
DEPLOY_SCRIPT=
DEPLOY_LOG=
DEPLOY_APP_SLUG=web-prod-2026
GIT_REPO=https://github.com/VitoMontenegro/gaido.git
GIT_BRANCH=main

# Telegram support bot (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
