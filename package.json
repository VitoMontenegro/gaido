{
  "name": "gaido",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @gaido/portal -w @gaido/svit -w @gaido/servis -w @gaido/vezu",
    "dev:portal": "npm run dev -w @gaido/portal -- --host 127.0.0.1 --port 5173",
    "dev:svit": "npm run dev -w @gaido/svit -- --host 127.0.0.1 --port 5174",
    "dev:servis": "npm run dev -w @gaido/servis -- --host 127.0.0.1 --port 5175",
    "dev:vezu": "npm run dev -w @gaido/vezu -- --host 127.0.0.1 --port 5176",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
